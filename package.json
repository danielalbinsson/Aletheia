{
  "name": "aletheia",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "description": "Local-first inspector for Vercel eve agents — self-portrait and authority diff.",
  "keywords": [
    "eve",
    "vercel-eve",
    "aletheia",
    "agent-legibility",
    "capability-review",
    "agent-skills",
    "ai-agent",
    "agent-trust",
    "self-portrait"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielalbinsson/Aletheia.git"
  },
  "homepage": "https://github.com/danielalbinsson/Aletheia#readme",
  "bugs": {
    "url": "https://github.com/danielalbinsson/Aletheia/issues"
  },
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "aletheia": "bin/aletheia.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:agent": "eve build",
    "build:cli": "pnpm --dir packages/aletheia-cli build && mkdir -p bin && cp packages/aletheia-cli/bin/aletheia.mjs bin/aletheia.mjs && chmod +x bin/aletheia.mjs",
    "build:cli:npm": "pnpm --dir packages/aletheia-cli build",
    "pack:cli": "pnpm --dir packages/aletheia-cli pack",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@uiw/react-codemirror": "^4.25.10",
    "ai": "^7.0.2",
    "eve": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "microsandbox": "^0.5.10",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
