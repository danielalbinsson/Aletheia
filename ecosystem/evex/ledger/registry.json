        "docs": {
          "overview": [
            "Ledger is a finance reconciliation eve agent blueprint from Aletheia. It fetches transactions, categorizes, reconciles, posts entries, flags anomalies, and runs month-close with an auditor subagent.",
            "Because it reaches bank and QuickBooks-shaped APIs, inspect it with Aletheia before enabling real credentials."
          ],
          "howItWorks": [
            "Nightly schedule prompts reconciliation; tools fetch and categorize transactions.",
            "Anomalies stop the happy path via flag_anomaly; posting is explicit.",
            "Auditor subagent reviews entries before month close."
          ],
          "useCases": [
            {
              "title": "Bookkeeping assistant scaffold",
              "body": "Replace stub OpenAPI hosts with your bank and ledger providers."
            },
            {
              "title": "Authority-diff demo",
              "body": "Use aletheia diff in CI when you add new financial reach."
            }
          ],
          "requirements": [
            {
              "name": "AI_GATEWAY_API_KEY",
              "body": "Or Vercel OIDC for the gateway model in agent.ts."
            },
            {
              "name": "BANK_API_KEY",
              "body": "Token for the bank OpenAPI connection."
            },
            {
              "name": "QUICKBOOKS_TOKEN",
              "body": "Token for the QuickBooks OpenAPI connection."
            },
            {
              "name": "SLACK_BOT_TOKEN",
              "body": "Optional Slack MCP connection."
            }
          ],
          "faqs": [
            {
              "question": "Is this ready for real money movement?",
              "answer": "No. Stubs and example OpenAPI hosts only. Treat as a blueprint and gate authority changes with Aletheia."
            }
          ]
